<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 允许引入 miuix-blur 并在运行时自适应门控 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- 获取设备完整已安装应用列表权限 (Android 11+ Package Visibility) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 允许 App 完全实时读取系统真实桌面壁纸与触觉反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 静音/响铃模式切换（App 进程直调 AudioManager.setRingerMode 的前置权限） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 勿扰模式切换（通知策略访问；实际授予仍由 Root allow_dnd 兜底） -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.HyperOpen">

        <!-- LSPosed / Xposed 模块声明元数据 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="小米澎湃OS指纹快捷方式增强：蜂窝样式、柔光玻璃与高斯模糊双材质、任意自定义动作" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!--
            MainActivity 同时承担两个入口：
            1. MODULE_SETTINGS：LSPosed 管理器里「打开」模块时使用；
            2. activity-alias LauncherEntry 的 targetActivity：桌面 / 抽屉图标。
            桌面图标由单独的 alias 承载，隐藏图标只禁用 alias，MainActivity 本身仍在，
            不会出现「隐藏后连设置页都打不开」的自锁。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口。name 用完整类名，代码侧 util/LauncherIcon.kt 里同名字符串 -->
        <activity-alias
            android:name="io.github.qmryqmm.hyperopen.LauncherEntry"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 跨进程配置共享 Provider (给 SystemUI 实时提供最新配置) -->
        <!-- directBootAware：用户未解锁（Direct Boot 锁定期）时也必须可访问，
             否则 SystemUI 开机启动时查不到安全模式状态，模块无法生效 -->
        <provider
            android:name=".provider.SettingsProvider"
            android:authorities="io.github.qmryqmm.hyperopen.provider"
            android:exported="true"
            android:directBootAware="true"
            android:multiprocess="false" />
    </application>

</manifest>
