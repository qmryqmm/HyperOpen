{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperopen-market",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyperopen-market",
      "database_id": "be221310-b1f2-4e46-8e5e-3a578868d776"
    }
  ]
  // Secrets (never put in this file):
  //   ADMIN_TOKEN -> wrangler secret put ADMIN_TOKEN
}
